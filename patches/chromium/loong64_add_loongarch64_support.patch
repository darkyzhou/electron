+      case LASX_CTX_MAGIC: {
+        // Same as LSX, but each FP register occupies the lowest of four
+        // 64-bit lanes.
+        if (head.size < sizeof(struct lasx_context) + sizeof(head)) {
+          LOG(ERROR) << "unexpected lasx context size " << head.size;
+          return false;
+        }
+        struct lasx_context lasxcontext;
+        if (!range.Read(reserved_address, sizeof(lasxcontext), &lasxcontext)) {
+          LOG(ERROR) << "Couldn't read lasx context " << head.size;
+          return false;
