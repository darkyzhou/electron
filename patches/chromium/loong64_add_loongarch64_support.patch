+        for (int i = 0; i < 32; ++i) {
+          fpucontext.fpregs[i] = lsxcontext.regs[2 * i];
+        }
+        fpucontext.fcc = lsxcontext.fcc;
+        fpucontext.fcsr = lsxcontext.fcsr;
+        InitializeCPUContextLOONG64_OnlyFPU(fpucontext, dest_context);
+        return true;
